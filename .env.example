# ==============================================================================
# kiosk (JAMANVAAR cloud/api + all 8 frontend apps) — Production Deployment Environment
# Two real deployment shapes share this one file -- see which applies to the box you're
# filling this in for:
#   (A) AWS bridge box (system.kelviontech.in), alongside amitkhatri, Wrench,
#       kelviontech.in and restaurent.kelviontech.in -- see AWS_DEPLOYMENT_MASTER_PLAN.md.
#       Shared kelviontech-nginx-1 container is the front door; this stack's own
#       containers publish to 172.17.0.1:<port> for it to reach. COMPOSE_PROFILES stays
#       unset here.
#   (B) A dedicated box with nothing else on it (e.g. kelviontech-prod-2 on Oracle) --
#       see ORACLE_KELVIONTECH_PROD_2_SETUP.md. This stack's own `proxy` service (nginx)
#       is the only thing bound to the host, at port 80 directly -- set
#       COMPOSE_PROFILES=oracle to enable it (see docker-compose.yml's `proxy` service).
# ==============================================================================

# ── 0. Compose profile (dedicated-box deployments only) ────────────────────────
# Uncomment on a dedicated box (shape B above) to start the `proxy` service. Leave unset
# on the AWS bridge box (shape A) -- that `proxy` service binds host port 80, which would
# collide with the separate kelviontech-nginx-1 container that already owns it there.
# COMPOSE_PROFILES=oracle

# ── 1. Host networking (multi-site port allocation) ───────────────────────────
# Shape A only (ignored under COMPOSE_PROFILES=oracle, shape B's `proxy` service reaches
# every app over the internal Docker network by service name instead, not these ports).
# 8090 avoids amitkhatri (8080), kelvion (3000/8000), restaurent (3001/8001) and
# Wrench (8085) -- confirm nothing else on the box has since taken it before using it.
PORT=8090
# 172.17.0.1 (the Docker bridge gateway), not 0.0.0.0 -- every app's port below is only
# ever meant to be reached by the shared kelviontech-nginx-1 container, which terminates
# real TLS for system.kelviontech.in first. Matches the box's own live convention
# (amitkhatri-web-1 binds 172.17.0.1:8080, confirmed on the real server, not assumed).
HOST_BIND_IP=172.17.0.1

# One port per new terminal/customer app (see docker-compose.yml) -- 8091-8097, picking
# up right after super-admin-web's 8090, still clear of every other project's ports
# listed above. Shape A only, same as PORT/HOST_BIND_IP above.
KIOSK_ADMIN_PORT=8091
KIOSK_USER_PORT=8092
POS_PORT=8093
POS_ADMIN_PORT=8094
CAPTAIN_PORT=8095
KDS_PORT=8096
QR_GUEST_PORT=8097

# This deployment's real public origin -- https://system.kelviontech.in on both shape A
# (AWS) and shape B (Oracle, kelviontech-prod-2 -- DNS points here as of 2026-10-05, a
# real Let's Encrypt cert is live). A bare http://<reserved-ip> value only applies
# during a brand new shape-B box's initial bring-up, before DNS/TLS are set up for it.
# Used as the build arg for every terminal/customer app's VITE_CLOUD_API_BASE_URL (and
# pos-admin's VITE_QR_ORDER_URL) -- see nginx/system.kelviontech.in.conf (shape A) or
# nginx/oracle-testing-proxy.conf (shape B) and docker-compose.yml's new services. Every
# app shares this one origin, so these absolute, build-time-baked fetches stay
# same-origin -- no CORS needed, same effect as super-admin-web's own relative-path
# pattern (VITE_API_BASE_URL, section 9 below, which stays empty -- only these newer
# apps need an absolute value baked in).
PUBLIC_ORIGIN=https://system.kelviontech.in

# Only needed if super-admin-web is ever moved OFF the domain root on some future
# dedicated box -- it owns the root on both shape A (system.kelviontech.in, the AWS
# box) and shape B (Oracle, nginx/oracle-testing-proxy.conf's own root block) today, so
# this stays empty on both. If a later deployment puts it under a subpath instead, set
# that subpath here (e.g. "/admin") to keep its client-side routing (BrowserRouter's
# basename, cloud/super-admin-web/src/app/App.tsx) working past the first page load.
SUPER_ADMIN_BASE_PATH=

# Dedicated loopback-only ports (not reachable from outside this machine) -- for direct
# health checks / debugging only. Avoids kelvion (5432/5433), Wrench (5435/8005).
DB_PORT=5436
BACKEND_PORT=8010

# ── 2. Database ────────────────────────────────────────────────────────────────
# The bootstrap Postgres superuser -- used ONLY to initialize the container and create the
# real app role below (docker-init-app-role.sh). The app itself never connects as this.
# Generate with: openssl rand -hex 24
POSTGRES_BOOTSTRAP_USER=postgres
POSTGRES_BOOTSTRAP_PASSWORD=

# The real role cloud/api connects as (jamanvaar_app, NOSUPERUSER NOBYPASSRLS) -- created
# automatically the first time the db container starts. Row-Level Security (the real
# tenant-isolation boundary) is only actually enforced when the app connects as this role,
# not the bootstrap superuser above -- cloud/api refuses to boot in production otherwise.
# Generate with: openssl rand -hex 24
APP_DB_PASSWORD=

# ── 3. Application security (REQUIRED -- cloud/api refuses to boot without these) ─────
# Generate every secret below with the project's own generator, which writes fresh random
# values to a file OUTSIDE this repo (never printed, never committed):
#   node cloud/api/scripts/generate-production-env.js
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
PRIVILEGED_REFRESH_TTL_DAYS=7

# The real public origin(s) every frontend app is served from. No localhost, no "*" --
# cloud/api refuses to boot in production with either. Every app (super-admin-web at
# root, and the terminal/customer apps under their own subpaths -- see
# nginx/system.kelviontech.in.conf for shape A or nginx/oracle-testing-proxy.conf for
# shape B) shares this ONE origin, same value as PUBLIC_ORIGIN above -- no reason for
# these two to ever differ on either deployment shape.
CORS_ALLOWED_ORIGINS=https://system.kelviontech.in

# Number of reverse proxy hops in front of cloud/api. There are TWO here, not one: the
# host nginx terminating TLS for system.kelviontech.in, then this container's own nginx
# (cloud/super-admin-web/nginx.conf) proxying /api/v1/* onward to the backend container --
# each hop appends its own entry to X-Forwarded-For. Get this number wrong and per-address
# rate limits (login, QR, terminal sync) key on a proxy's address instead of the real
# visitor's.
TRUST_PROXY=2

# Optional -- falls back to JWT_ACCESS_SECRET when unset. Separate secret for QR guest
# session signatures, only needed if QR table ordering is used by restaurants on this box.
QR_SESSION_SECRET=

# ── 4. Jamanvaar <-> WhatsApp connector (optional) ─────────────────────────────
# Only needed if a restaurant on this deployment connects to the WhatsApp ordering
# connector (product/whatsapp, deployed separately). Must be the EXACT same value as
# product/whatsapp's own JAMANVAAR_SERVICE_SECRET -- it signs every call between the two.
# Never the literal dev placeholder; cloud/api checks for that specifically in production.
JAMANVAAR_SERVICE_SECRET=
WHATSAPP_CONNECTOR_BASE_URL=

# ── 5. Offline license certificate signing (optional) ──────────────────────────
# Only needed for offline dealer/terminal activation. Degrades to a clear 503 when unset,
# rather than crashing boot -- leave blank if this deployment doesn't need it yet.
LICENSE_SIGNING_PRIVATE_KEY_B64=
LICENSE_SIGNING_KEY_ID=

# ── 6. Off-device backups (optional) ────────────────────────────────────────────
# Any S3-compatible provider (AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces,
# self-hosted MinIO). Omit BACKUP_S3_ENDPOINT for real AWS S3. Required in production once
# set at all -- a backup is refused rather than silently stored unencrypted without this.
# Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY_B64=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# ── 7. Razorpay payments (optional) ─────────────────────────────────────────────
# Real sandbox/production credentials -- see docs/PROGRESS_LOG.md for this project's own
# "test-mode only, never real money in testing" discipline. Leave unset until a restaurant
# on this deployment actually needs online payments.
# Names must match cloud/api/src/config/env.validation.ts exactly (confirmed by reading
# it, not assumed) -- RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET, not *_CLIENT_ID/*_CLIENT_SECRET;
# docker-compose.yml's backend service reads these same two names. No
# RAZORPAY_ENVIRONMENT var exists in the actual code -- left out here, not just unset.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# AES-256-GCM key (32 bytes, base64) for encrypting settlement bank details at rest.
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=

# ── 8. Transactional email (optional) ───────────────────────────────────────────
# Degrades to "email not sent, logged" when unset -- OTP/password-reset emails simply won't
# go out until this is configured. Never commit a real app password to this file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=JAMANVAAR
SMTP_FROM_EMAIL=

# ── 9. Frontend build-time config ───────────────────────────────────────────────
# Leave empty: the built SPA calls same-origin /api/v1/... paths, and this container's own
# nginx (cloud/super-admin-web/nginx.conf) proxies those to the backend container. Setting
# this to an absolute URL is only for a split-origin deployment (frontend and API on
# different hosts), which this compose file doesn't set up.
VITE_API_BASE_URL=
