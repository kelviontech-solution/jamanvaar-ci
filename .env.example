# ==============================================================================
# kiosk (JAMANVAAR cloud/api + super-admin-web) — Production Deployment Environment
# Target: system.kelviontech.in, on the same AWS EC2 bridge box as amitkhatri, Wrench,
# kelviontech.in and restaurent.kelviontech.in -- see AWS_DEPLOYMENT_MASTER_PLAN.md.
# ==============================================================================

# ── 1. Host networking ──────────────────────────────────────────────────────────
# PORT / HOST_BIND_IP are only meaningful on the AWS bridge box's shared-nginx pattern
# (see AWS_DEPLOYMENT_MASTER_PLAN.md) -- on a dedicated box like kelviontech-prod-2
# (Oracle), the `proxy` service in docker-compose.yml is the only thing bound to the
# host (0.0.0.0:80), so these two are unused there. Leave unset unless deploying behind
# a shared host-level nginx the old way.
PORT=8090
HOST_BIND_IP=172.17.0.1

# This box's own publicly reachable origin, e.g. http://130.210.16.150 for
# kelviontech-prod-2 (no scheme-less bare IP/host -- every frontend app below needs the
# full http(s)://host[:port] baked in at build time). Used as the build arg for every
# terminal/customer app's VITE_CLOUD_API_BASE_URL (and pos-admin's VITE_QR_ORDER_URL) --
# see nginx/oracle-testing-proxy.conf and docker-compose.yml's new services. Leave unset
# on the AWS/production same-origin pattern, where super-admin-web is the only frontend
# and VITE_API_BASE_URL (section 9 below) stays empty instead.
PUBLIC_ORIGIN=

# Dedicated loopback-only ports (not reachable from outside this machine) -- for direct
# health checks / debugging only. Avoids kelvion (5432/5433), Wrench (5435/8005).
DB_PORT=5436
BACKEND_PORT=8010

# ── 2. Database ────────────────────────────────────────────────────────────────
# The bootstrap Postgres superuser -- used ONLY to initialize the container and create the
# real app role below (docker-init-app-role.sh). The app itself never connects as this.
# Generate with: openssl rand -hex 24
POSTGRES_BOOTSTRAP_USER=postgres
POSTGRES_BOOTSTRAP_PASSWORD=

# The real role cloud/api connects as (jamanvaar_app, NOSUPERUSER NOBYPASSRLS) -- created
# automatically the first time the db container starts. Row-Level Security (the real
# tenant-isolation boundary) is only actually enforced when the app connects as this role,
# not the bootstrap superuser above -- cloud/api refuses to boot in production otherwise.
# Generate with: openssl rand -hex 24
APP_DB_PASSWORD=

# ── 3. Application security (REQUIRED -- cloud/api refuses to boot without these) ─────
# Generate every secret below with the project's own generator, which writes fresh random
# values to a file OUTSIDE this repo (never printed, never committed):
#   node cloud/api/scripts/generate-production-env.js
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
PRIVILEGED_REFRESH_TTL_DAYS=7

# The real public origin(s) every frontend app is served from. No localhost, no "*" --
# cloud/api refuses to boot in production with either. On kelviontech-prod-2 (Oracle),
# every app lives behind the one `proxy` service on the SAME origin (see PUBLIC_ORIGIN
# above and nginx/oracle-testing-proxy.conf), so this should be that exact same value,
# e.g. http://130.210.16.150 -- not the production https://system.kelviontech.in below.
CORS_ALLOWED_ORIGINS=https://system.kelviontech.in

# Number of reverse proxy hops in front of cloud/api. There are TWO here, not one: the
# host nginx terminating TLS for system.kelviontech.in, then this container's own nginx
# (cloud/super-admin-web/nginx.conf) proxying /api/v1/* onward to the backend container --
# each hop appends its own entry to X-Forwarded-For. Get this number wrong and per-address
# rate limits (login, QR, terminal sync) key on a proxy's address instead of the real
# visitor's.
TRUST_PROXY=2

# Optional -- falls back to JWT_ACCESS_SECRET when unset. Separate secret for QR guest
# session signatures, only needed if QR table ordering is used by restaurants on this box.
QR_SESSION_SECRET=

# ── 4. Jamanvaar <-> WhatsApp connector (optional) ─────────────────────────────
# Only needed if a restaurant on this deployment connects to the WhatsApp ordering
# connector (product/whatsapp, deployed separately). Must be the EXACT same value as
# product/whatsapp's own JAMANVAAR_SERVICE_SECRET -- it signs every call between the two.
# Never the literal dev placeholder; cloud/api checks for that specifically in production.
JAMANVAAR_SERVICE_SECRET=
WHATSAPP_CONNECTOR_BASE_URL=

# ── 5. Offline license certificate signing (optional) ──────────────────────────
# Only needed for offline dealer/terminal activation. Degrades to a clear 503 when unset,
# rather than crashing boot -- leave blank if this deployment doesn't need it yet.
LICENSE_SIGNING_PRIVATE_KEY_B64=
LICENSE_SIGNING_KEY_ID=

# ── 6. Off-device backups (optional) ────────────────────────────────────────────
# Any S3-compatible provider (AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces,
# self-hosted MinIO). Omit BACKUP_S3_ENDPOINT for real AWS S3. Required in production once
# set at all -- a backup is refused rather than silently stored unencrypted without this.
# Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY_B64=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# ── 7. Razorpay payments (optional) ─────────────────────────────────────────────
# Real sandbox/production credentials -- see docs/PROGRESS_LOG.md for this project's own
# "test-mode only, never real money in testing" discipline. Leave unset until a restaurant
# on this deployment actually needs online payments.
RAZORPAY_CLIENT_ID=
RAZORPAY_CLIENT_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENVIRONMENT=sandbox
# AES-256-GCM key (32 bytes, base64) for encrypting settlement bank details at rest.
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=

# ── 8. Transactional email (optional) ───────────────────────────────────────────
# Degrades to "email not sent, logged" when unset -- OTP/password-reset emails simply won't
# go out until this is configured. Never commit a real app password to this file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=JAMANVAAR
SMTP_FROM_EMAIL=

# ── 9. Frontend build-time config ───────────────────────────────────────────────
# Leave empty: the built SPA calls same-origin /api/v1/... paths, and this container's own
# nginx (cloud/super-admin-web/nginx.conf) proxies those to the backend container. Setting
# this to an absolute URL is only for a split-origin deployment (frontend and API on
# different hosts), which this compose file doesn't set up.
VITE_API_BASE_URL=
