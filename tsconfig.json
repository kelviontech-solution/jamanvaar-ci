{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@jamanvaar/types": ["./packages/types/src"],
      "@jamanvaar/types/*": ["./packages/types/src/*"],
      "@jamanvaar/config": ["./packages/config/src"],
      "@jamanvaar/config/*": ["./packages/config/src/*"],
      "@jamanvaar/i18n": ["./packages/i18n/src"],
      "@jamanvaar/i18n/*": ["./packages/i18n/src/*"],
      "@jamanvaar/utils": ["./packages/utils/src"],
      "@jamanvaar/utils/*": ["./packages/utils/src/*"],
      "@jamanvaar/business": ["./packages/business/src"],
      "@jamanvaar/business/*": ["./packages/business/src/*"],
      "@jamanvaar/validation": ["./packages/validation/src"],
      "@jamanvaar/validation/*": ["./packages/validation/src/*"],
      "@jamanvaar/database": ["./packages/database/src"],
      "@jamanvaar/database/*": ["./packages/database/src/*"],
      "@jamanvaar/api": ["./packages/api/src"],
      "@jamanvaar/api/*": ["./packages/api/src/*"],
      "@jamanvaar/sync": ["./packages/sync/src"],
      "@jamanvaar/sync/*": ["./packages/sync/src/*"],
      "@jamanvaar/ui": ["./packages/ui/src"],
      "@jamanvaar/ui/*": ["./packages/ui/src/*"]
    }
  },
  // cloud/api is a separate NestJS project with its own tsconfig (decorator
  // metadata, commonjs modules) and its own independent typecheck script —
  // it must not be swept into this project's default include, which has no
  // "include" of its own and would otherwise pick up every .ts file in the repo.
  "exclude": ["cloud/**", "node_modules"]
}
