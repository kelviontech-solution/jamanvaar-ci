# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://jamanvaar_app:CHANGE_ME@localhost:5432/pos?schema=public"
PORT=4000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="CHANGE_ME"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# Seeded during `npm run seed --workspace=@jamanvaar/cloud-api`
SEED_SUPER_ADMIN_EMAIL="superadmin@jamanvaar.app"

# Optional — offline license certificate signing (ENT-001 fix). Without this,
# restaurants with no live cloud connection cannot receive a Super-Admin-issued
# plan change; the feature degrades to a clear 503, not a silent failure.
# Generate a keypair with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{publicKey,privateKey}=generateKeyPairSync('ec',{namedCurve:'P-256'});console.log('PRIVATE (put in .env, base64):');console.log(Buffer.from(privateKey.export({format:'pem',type:'pkcs8'})).toString('base64'));console.log('PUBLIC JWK (put in packages/business/src/license_certificate.ts):');console.log(JSON.stringify(publicKey.export({format:'jwk'})));"
LICENSE_SIGNING_PRIVATE_KEY_B64=""

# Optional — real off-device backup storage (§06/§17 of the platform audit).
# Any S3-compatible provider works: AWS S3, Cloudflare R2, Backblaze B2,
# DigitalOcean Spaces, or a self-hosted MinIO. Without these set, backup
# uploads fail with a clear 503 rather than silently pretending to succeed.
#   AWS S3:        omit BACKUP_S3_ENDPOINT; region = your bucket's real region
#   Cloudflare R2: BACKUP_S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
#   Backblaze B2:  BACKUP_S3_ENDPOINT="https://s3.<region>.backblazeb2.com"
#   MinIO:         BACKUP_S3_ENDPOINT="https://your-minio-host:9000", BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION="auto"
BACKUP_S3_BUCKET=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
BACKUP_S3_FORCE_PATH_STYLE="false"

# Optional — transactional email (owner invites, resend-invite). Without
# these set, invites/resends still work — the activation token is returned
# to the Super Admin console to relay manually — but no email is sent.
# Any SMTP provider works (SES SMTP, SendGrid SMTP, Postmark, Gmail app
# password for testing, etc).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="JAMANVAAR"
