# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://jamanvaar_app:CHANGE_ME@localhost:5432/pos?schema=public"
PORT=4000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="CHANGE_ME"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# Seeded during `npm run seed --workspace=@jamanvaar/cloud-api`
SEED_SUPER_ADMIN_EMAIL="superadmin@jamanvaar.app"
