// JAMANVAAR Cloud — Phase 1a schema.
//
// Row-Level Security note: Prisma cannot express RLS policies declaratively.
// The initial migration is generated with `prisma migrate dev --create-only`
// and then hand-edited (see prisma/migrations/*_init/migration.sql) to add
// `ENABLE ROW LEVEL SECURITY` + `FORCE ROW LEVEL SECURITY` + policies on every
// tenant-owned table. FORCE is required — Postgres exempts table owners from
// RLS by default, and the app's DB role owns these tables, so without FORCE
// the policies below would be silently decorative.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Platform (Super Admin) identity — structurally separate from tenant User.
// No code path maps one to the other; a restaurant owner row can never
// satisfy a platform login query because it isn't in this table at all.
// ---------------------------------------------------------------------------

enum PlatformUserStatus {
  ACTIVE
  DISABLED
  PENDING_ACTIVATION
}

// Team/RBAC roles for platform staff — previously the API hardcoded every
// user's role to 'SUPER_ADMIN' in its responses regardless of this table,
// so hasPermission() on the frontend had nothing real to check.
enum PlatformRole {
  PLATFORM_OWNER
  SUPER_ADMIN
  PLATFORM_OPS
  SUPPORT_ADMIN
  FINANCE_ADMIN
  READ_ONLY
}

model PlatformUser {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String?            // null until a PENDING_ACTIVATION teammate sets their own password
  fullName     String
  role         PlatformRole       @default(SUPER_ADMIN)
  status       PlatformUserStatus @default(ACTIVE)
  invitedAt    DateTime?
  activatedAt  DateTime?
  // One-time invitation credential for activate() — same shape as
  // User.activationTokenHash (SEC-001): only the sha256 hash is stored, the
  // plaintext token is returned once, at invite time.
  activationTokenHash      String?
  activationTokenExpiresAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  refreshTokens    PlatformRefreshToken[]
  assignedTickets  SupportTicket[]
  createdTickets   SupportTicket[] @relation("SupportTicketCreatedBy")
  ticketComments   TicketComment[]
}

model PlatformRefreshToken {
  id             String    @id @default(uuid())
  platformUserId String
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([platformUserId])
}

// ---------------------------------------------------------------------------
// Tenant hierarchy: Restaurant -> Branch -> User / Device.
// These four plus Subscription and ActivationKey are RLS-protected.
// ---------------------------------------------------------------------------

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Restaurant {
  id              String           @id @default(uuid())
  name            String
  legalName       String?
  gstin           String?
  fssaiNumber     String?
  address         String?
  city            String?
  state           String?
  country         String           @default("India")
  timezone        String           @default("Asia/Kolkata")
  currency        String           @default("INR")
  defaultLanguage String           @default("en")
  status          RestaurantStatus @default(ACTIVE)
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  branches      Branch[]
  users         User[]
  devices       Device[]
  subscriptions Subscription[]
  activationKeys ActivationKey[]
  invoices      Invoice[]
  payments      Payment[]
  backups       Backup[]
  supportTickets SupportTicket[]
  deviceCommands      DeviceCommand[]
  menuSyndications    RestaurantMenuSyndication[]
  syncEventLogs       SyncEventLog[]
  syncConflicts       SyncConflict[]
  offlineExtensions   OfflineExtension[]
  sandboxes           RestaurantSandbox[]
  restoreJobs         BackupRestoreJob[]
  applicationEntitlements ApplicationEntitlement[]
  orders                  Order[]
  paymentTransactions     PaymentTransaction[]
  paymentConnection       RestaurantPaymentConnection?
  refunds                 Refund[]
  webhookEvents           WebhookEvent[]
  menuSnapshotItems       MenuSnapshotItem[]
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

model Branch {
  id           String       @id @default(uuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  code         String
  address      String?
  timezone     String       @default("Asia/Kolkata")
  status       BranchStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users   User[]
  devices Device[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
}

enum TenantUserRole {
  OWNER
  MANAGER
  STAFF
}

enum TenantUserStatus {
  PENDING_ACTIVATION
  ACTIVE
  DISABLED
}

model User {
  id           String            @id @default(uuid())
  restaurantId String
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  email        String
  phone        String?
  passwordHash String?           // null until a PENDING_ACTIVATION owner sets their own password
  fullName     String
  role         TenantUserRole    @default(STAFF)
  status       TenantUserStatus  @default(PENDING_ACTIVATION)
  invitedAt    DateTime?
  activatedAt  DateTime?
  // One-time invitation credential for setInitialPassword (SEC-001). Only the
  // sha256 hash is stored — the plaintext token is returned once, at creation
  // time, the same way ActivationKey.code is. Both must be cleared/consumed
  // once a password is successfully set.
  activationTokenHash      String?
  activationTokenExpiresAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  refreshTokens TenantRefreshToken[]

  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@index([branchId])
}

// Tenant-user session tokens. Kept separate from PlatformRefreshToken (which is
// FK'd only to PlatformUser) since tenant and platform identities are structurally
// distinct. restaurantId is denormalized onto this row (not just reachable via
// userId) so the same tenant_isolation RLS policy shape used elsewhere applies here.
model TenantRefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([restaurantId])
}

// ---------------------------------------------------------------------------
// Plans are platform-global (no restaurantId, no RLS).
// ---------------------------------------------------------------------------

enum PlanTier {
  CORE
  PRO
  ENTERPRISE
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

model Plan {
  id           String     @id @default(uuid())
  tier         PlanTier
  name         String
  description  String?
  priceMonthly Int // paise, avoids float rounding
  priceYearly  Int?
  maxBranches  Int
  maxDevices   Int
  maxUsers     Int
  entitlements Json
  status       PlanStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  EXPIRED
}

model Subscription {
  id           String             @id @default(uuid())
  restaurantId String
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan               @relation(fields: [planId], references: [id])
  status       SubscriptionStatus @default(TRIAL)
  startDate    DateTime           @default(now())
  expiresAt    DateTime
  trialEndsAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  activationKeys ActivationKey[]
  invoices       Invoice[]
  applicationEntitlements ApplicationEntitlement[]

  @@index([restaurantId])
}

// ---------------------------------------------------------------------------
// Per-application provisioning. This is the reusable entitlement layer every
// client app (POS, POS Admin, Captain, KDS, Kiosk, Kiosk Admin) is gated
// against — one row per (subscription, appCode), rather than duplicating
// "is this app enabled" logic per application the way Plan.entitlements'
// flat boolean bag used to (and still does, for legacy/display purposes;
// this table is the actual source of truth going forward). restaurantId is
// denormalized here the same way ActivationKey does it, so the standard
// tenant_isolation RLS policy shape (restaurantId-keyed) applies unchanged.
// ---------------------------------------------------------------------------
enum AppCode {
  POS
  POS_ADMIN
  CAPTAIN
  KDS
  KIOSK
  KIOSK_ADMIN
}

model ApplicationEntitlement {
  id             String       @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  appCode        AppCode
  enabled        Boolean      @default(true)
  // Null means "inherit the plan's overall maxDevices" rather than a
  // per-app cap — most restaurants never need to override this.
  deviceQuota    Int?
  // Per-app configuration that doesn't belong on Restaurant/Branch: e.g.
  // { "menuSource": "MAIN_MENU", "paymentMode": "COUNTER_ONLY" } for Kiosk.
  // Optional and schemaless on purpose — each app defines its own shape.
  config         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([subscriptionId, appCode])
  @@index([restaurantId])
}

enum ActivationKeyDeviceType {
  POS
  POS_ADMIN
  CAPTAIN
  KDS
  KIOSK
  KIOSK_ADMIN
  ANY
}

enum ActivationKeyStatus {
  ACTIVE
  REDEEMED
  REVOKED
  EXPIRED
}

model ActivationKey {
  id                 String                  @id @default(uuid())
  code               String                  @unique // opaque public identifier, not a password
  restaurantId       String
  restaurant         Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  subscriptionId     String?
  subscription       Subscription?           @relation(fields: [subscriptionId], references: [id])
  allowedDeviceType  ActivationKeyDeviceType  @default(ANY)
  status             ActivationKeyStatus     @default(ACTIVE)
  expiresAt          DateTime
  redeemedAt         DateTime?
  redeemedByDeviceId String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([restaurantId])
}

enum DeviceType {
  POS
  CAPTAIN
  KDS
  KIOSK
  POS_ADMIN
  KIOSK_ADMIN
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

model Device {
  id           String       @id @default(uuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  type         DeviceType
  publicKey    String?      // populated once the keypair activation flow (later phase) ships
  appVersion   String?
  status       DeviceStatus @default(PENDING)
  lastSeenAt   DateTime?
  lastSyncAt   DateTime?    // last time this device's local runtime successfully synced
  lastBackupAt DateTime?    // last time this device reported a completed local backup
  syncStatus   String?      // free-form status string reported by the device (e.g. "ok", "stale", "error: <reason>")
  // sha256 hash of the opaque bearer credential issued once at activation-redeem
  // time (DeviceAuthGuard). Never store the plaintext — same pattern as
  // TenantRefreshToken.tokenHash and User.activationTokenHash.
  deviceTokenHash String?  @unique
  activatedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  name             String?
  ipAddress        String?
  macAddress       String?
  osPlatform       String?
  isLocked         Boolean         @default(false)
  lockReason       String?
  lockedAt         DateTime?
  pendingSyncCount Int             @default(0)
  syncError        String?

  backups          Backup[]
  commands         DeviceCommand[]
  syncEventLogs    SyncEventLog[]
  syncConflicts    SyncConflict[]
  offlineExtensions OfflineExtension[]
  orders           Order[]

  @@index([restaurantId])
  @@index([branchId])
}

// ---------------------------------------------------------------------------
// Audit log — platform-readable, not RLS-scoped in this phase.
// ---------------------------------------------------------------------------

enum AuditActorType {
  PLATFORM
  TENANT
  SYSTEM
}

model AuditLog {
  id           String         @id @default(uuid())
  actorType    AuditActorType
  actorId      String?
  restaurantId String?
  action       String
  category     String
  details      Json?
  createdAt    DateTime       @default(now())

  @@index([restaurantId])
  @@index([actorType, actorId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Support Tickets — evolves the Support page from search+diagnostics into a
// real lightweight ticketing view (status, assignee, SLA), instead of every
// support interaction being a one-off audited action with no persistent
// record of the underlying issue.
// ---------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id           String         @id @default(uuid())
  restaurantId String? // null = platform-wide issue, not tied to one tenant
  restaurant   Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  subject      String
  description  String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  assignedToId String?
  assignedTo   PlatformUser?  @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    PlatformUser   @relation("SupportTicketCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  slaDueAt     DateTime
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  comments TicketComment[]

  @@index([restaurantId])
  @@index([status])
  @@index([assignedToId])
}

model TicketComment {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    PlatformUser  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Billing & Invoices
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PAST_DUE
  VOID
  REFUNDED
}

enum PaymentMethod {
  MANUAL
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  GATEWAY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique
  restaurantId       String
  restaurant         Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  subscriptionId     String?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])
  planId             String?
  plan               Plan?         @relation(fields: [planId], references: [id])
  amount             Int           // in paise
  taxAmount          Int           // in paise (GST 18%)
  totalAmount        Int           // in paise
  currency           String        @default("INR")
  status             InvoiceStatus @default(ISSUED)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  dueDate            DateTime
  paidAt             DateTime?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payments Payment[]

  @@index([restaurantId])
  @@index([status])
}

model Payment {
  id              String        @id @default(uuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  restaurantId    String
  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  amount          Int           // in paise
  method          PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  receiptNumber   String?       @unique
  status          PaymentStatus @default(COMPLETED)
  notes           String?
  recordedBy      String?
  createdAt       DateTime      @default(now())

  @@index([invoiceId])
  @@index([restaurantId])
}

// ---------------------------------------------------------------------------
// Applications & Release Matrix
// ---------------------------------------------------------------------------

enum AppReleaseChannel {
  STABLE
  BETA
}

model AppRelease {
  id                  String             @id @default(uuid())
  appCode             String             // POS, RESTAURANT_ADMIN, CAPTAIN, KDS, KIOSK, KIOSK_ADMIN
  version             String             // e.g. "2.4.0"
  channel             AppReleaseChannel  @default(STABLE)
  minSupportedVersion String?
  supportedPlatforms  Json               // ["windows", "android", "web", "electron"]
  releaseNotes        String?
  downloadUrl         String?
  isMandatory         Boolean            @default(false)
  releasedAt          DateTime           @default(now())
  createdAt           DateTime           @default(now())

  @@unique([appCode, version])
  @@index([appCode])
}

// ---------------------------------------------------------------------------
// Platform Settings
// ---------------------------------------------------------------------------

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  category    String   @default("GENERAL")
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Real off-device backups. A row here means the payload was actually
// uploaded to object storage (see modules/backups/backup-storage.service.ts)
// — never created speculatively, never faked when storage isn't configured.
// ---------------------------------------------------------------------------

enum BackupMethod {
  MANUAL
  AUTOMATIC
}

enum BackupStatus {
  COMPLETED
  FAILED
}

model Backup {
  id                 String             @id @default(uuid())
  restaurantId       String
  restaurant         Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  deviceId           String?
  device             Device?            @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  method             BackupMethod       @default(MANUAL)
  status             BackupStatus       @default(COMPLETED)
  sizeBytes          Int
  storageKey         String             // object key within the configured bucket
  checksumSha256     String
  errorMessage       String?
  verificationStatus String?            @default("UNVERIFIED") // UNVERIFIED, VERIFIED, CORRUPT
  verifiedAt         DateTime?
  retentionDays      Int                @default(30)
  createdAt          DateTime           @default(now())

  restoreJobs        BackupRestoreJob[]

  @@index([restaurantId])
  @@index([deviceId])
}

// ---------------------------------------------------------------------------
// Device Remote Commands & MDM
// ---------------------------------------------------------------------------

enum DeviceCommandType {
  LOCK
  UNLOCK
  FORCE_LOGOUT
  REVOKE_SESSION
  REVOKE_AUTH
  REQUEST_SYNC
  REQUEST_HEALTH
  APP_UPDATE
  RESTART_APP
  CLEAR_CACHE
  REQUEST_DIAGNOSTICS
  DISABLE_DEVICE
  ENABLE_DEVICE
  WIPE_LOCAL_DATA
}

enum DeviceCommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  RUNNING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

model DeviceCommand {
  id             String              @id @default(uuid())
  deviceId       String
  device         Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  restaurantId   String
  restaurant     Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  commandType    DeviceCommandType
  status         DeviceCommandStatus @default(PENDING)
  payload        Json?
  result         Json?
  errorMessage   String?
  issuedById     String?
  issuedAt       DateTime            @default(now())
  acknowledgedAt DateTime?
  executedAt     DateTime?
  expiresAt      DateTime

  @@index([deviceId, status])
  @@index([restaurantId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Master Menu Catalog & Syndication
// ---------------------------------------------------------------------------

model MasterMenuCategory {
  id        String           @id @default(uuid())
  name      String           @unique
  slug      String           @unique
  icon      String?
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  items     MasterMenuItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model MasterMenuItem {
  id                     String                      @id @default(uuid())
  categoryId             String
  category               MasterMenuCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name                   String
  description            String?
  imageUrl               String?
  basePrice              Int                         // in paise
  preparationTimeMinutes Int                         @default(15)
  dietaryType            String                      @default("VEG") // VEG, NON_VEG, VEGAN, JAIN, SWAMINARAYAN
  isAvailable            Boolean                     @default(true)
  allergens              Json?                       // string[]
  tags                   Json?                       // string[]
  taxRate                Int                         @default(500) // 5.00% (500 paise basis points)
  hsnCode                String?                     @default("996331")
  recipe                 Json?
  syndications           RestaurantMenuSyndication[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([categoryId])
}

model RestaurantMenuSyndication {
  id           String         @id @default(uuid())
  restaurantId String
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  masterItemId String
  masterItem   MasterMenuItem @relation(fields: [masterItemId], references: [id], onDelete: Cascade)
  customPrice  Int?           // overridden restaurant price in paise
  customName   String?
  isCustomized Boolean        @default(false)
  autoSync     Boolean        @default(true)
  status       String         @default("ACTIVE")
  lastSyncedAt DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([restaurantId, masterItemId])
  @@index([restaurantId])
}

// ---------------------------------------------------------------------------
// Sync Observability & Conflicts
// ---------------------------------------------------------------------------

model SyncEventLog {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  deviceId     String?
  device       Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  entityType   String     // ORDER, MENU, INVENTORY, CUSTOMER
  action       String     // CREATE, UPDATE, DELETE
  status       String     // SUCCESS, FAILED, PENDING
  latencyMs    Int        @default(0)
  payloadSize  Int        @default(0)
  errorMessage String?
  timestamp    DateTime   @default(now())

  @@index([restaurantId, timestamp])
  @@index([status])
}

model SyncConflict {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  deviceId     String?
  device       Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  entityType   String
  entityId     String
  localVersion Json
  cloudVersion Json
  reason       String
  resolution   String     @default("PENDING") // PENDING, CLOUD_WINS, LOCAL_WINS, MANUAL_MERGE
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
  @@index([resolution])
}

// ---------------------------------------------------------------------------
// Emergency Offline Policy
// ---------------------------------------------------------------------------

model OfflineExtension {
  id                   String     @id @default(uuid())
  restaurantId         String
  restaurant           Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId             String?
  deviceId             String?
  device               Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  extensionDays        Int
  reason               String
  requestedBy          String
  approvedById         String
  status               String     @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  certificatePayload   String
  certificateSignature String
  validFrom            DateTime   @default(now())
  validUntil           DateTime
  createdAt            DateTime   @default(now())

  @@index([restaurantId])
  @@index([deviceId])
}

// ---------------------------------------------------------------------------
// Staging Sandbox Clones
// ---------------------------------------------------------------------------

model RestaurantSandbox {
  id                 String     @id @default(uuid())
  sourceRestaurantId String
  sourceRestaurant   Restaurant @relation(fields: [sourceRestaurantId], references: [id], onDelete: Cascade)
  name               String
  environmentKey     String     @unique
  status             String     @default("ACTIVE") // CREATING, ACTIVE, EXPIRED, DELETED
  config             Json
  expiresAt          DateTime
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([sourceRestaurantId])
}

// ---------------------------------------------------------------------------
// Backup Restore Jobs
// ---------------------------------------------------------------------------

model BackupRestoreJob {
  id             String     @id @default(uuid())
  backupId       String
  backup         Backup     @relation(fields: [backupId], references: [id], onDelete: Cascade)
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  targetType     String     // STAGING_PREVIEW, PRODUCTION_RESTORE
  status         String     @default("PENDING") // PENDING, PREVIEW_READY, RESTORING, COMPLETED, FAILED
  previewSummary Json?
  errorMessage   String?
  initiatedById  String
  confirmedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())

  @@index([restaurantId])
  @@index([backupId])
}

// ---------------------------------------------------------------------------
// Cashfree Payment Gateway — Phase 1 (see docs/superpowers/specs/2026-09-09-
// cashfree-payment-phase1-design.md). Distinct model/enum names from the
// existing Payment/PaymentMethod/PaymentStatus above, which are platform
// subscription billing, not customer-order payments.
// ---------------------------------------------------------------------------

enum PaymentProvider {
  CASHFREE
}

// Only PLATFORM_POOLED (Cashfree Easy Split, one JAMANVAAR-owned account) is
// implemented in Phase 1. A true per-restaurant merchant-account mode would
// be added later via `ALTER TYPE ... ADD VALUE`, the same way AppCode and
// ActivationKeyDeviceType were extended in the application-entitlements
// migration — it requires Cashfree Partner/Platform approval JAMANVAAR does
// not have yet.
enum PaymentConnectionType {
  PLATFORM_POOLED
}

enum PaymentConnectionStatus {
  NOT_CONNECTED
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISCONNECTED
}

enum OrderPaymentStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  SENT_TO_POS
  PAYMENT_FAILED
  CANCELLED
}

enum PaymentTransactionStatus {
  CREATED
  PENDING
  AUTHORIZED
  SUCCESS
  FAILED
  USER_DROPPED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentTransactionMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
  OTHER
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WebhookProcessingStatus {
  RECEIVED
  VERIFIED
  PROCESSED
  FAILED
  IGNORED_DUPLICATE
}

// The trusted, backend-queryable copy of what a restaurant actually sells —
// pushed by Kiosk Admin (which already has a live device connection)
// whenever its local menu changes. Order totals are validated against this,
// never against prices the kiosk sends at checkout time.
model MenuSnapshotItem {
  id             String     @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  externalItemId String // the kiosk's own local item id
  name           String
  category       String?
  basePrice      Int // paise
  modifierGroups Json? // [{ id, name, isRequired, minSelections, maxSelections, options: [{ id, name, priceDelta }] }]
  taxRate        Int        @default(0) // basis points, e.g. 500 = 5.00%
  isAvailable    Boolean    @default(true)
  syncedAt       DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([restaurantId, externalItemId])
  @@index([restaurantId])
}

// Cloud order record — does not exist elsewhere; kiosks are offline-first
// and never had a cloud order model before this. items is an immutable
// snapshot captured at creation time from MenuSnapshotItem.
model Order {
  id              String             @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  kioskId         String?
  kiosk           Device?            @relation(fields: [kioskId], references: [id], onDelete: SetNull)
  externalOrderId String // correlates to the kiosk's local order id; doubles as the idempotency key
  items           Json // [{ externalItemId, name, quantity, unitPrice, modifiers, lineTotal }]
  subtotal        Int // paise
  taxAmount       Int // paise
  discountAmount  Int                @default(0) // paise
  totalAmount     Int // paise
  currency        String             @default("INR")
  status          OrderPaymentStatus @default(DRAFT)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  paymentTransactions PaymentTransaction[]

  @@unique([restaurantId, externalOrderId])
  @@index([restaurantId])
  @@index([kioskId])
}

model PaymentTransaction {
  id                String                    @id @default(uuid())
  orderId           String
  order             Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurantId      String
  restaurant        Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  provider          PaymentProvider           @default(CASHFREE)
  providerOrderId   String // the order_id we generate and send to Cashfree
  providerPaymentId String? // Cashfree's cf_payment_id, known once paid/failed
  amount            Int // paise
  currency          String                    @default("INR")
  status            PaymentTransactionStatus  @default(CREATED)
  method            PaymentTransactionMethod?
  paymentSessionId  String?
  providerResponse  Json? // sanitized webhook/API response, no secrets
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  refunds Refund[]

  @@unique([provider, providerOrderId])
  @@unique([provider, providerPaymentId])
  @@index([restaurantId])
  @@index([orderId])
  @@index([providerPaymentId])
}

// One per restaurant. Represents the Cashfree Easy Split vendor
// registration for Phase 1 (PLATFORM_POOLED) — settlement bank/UPI details,
// not independent API credentials.
enum CashfreeAccountType {
  BUSINESS
  INDIVIDUAL
}

model RestaurantPaymentConnection {
  id                                String                  @id @default(uuid())
  restaurantId                      String                  @unique
  restaurant                        Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  provider                          PaymentProvider         @default(CASHFREE)
  connectionType                    PaymentConnectionType   @default(PLATFORM_POOLED)
  cashfreeVendorId                  String?
  accountType                       CashfreeAccountType?
  businessType                      String? // free text, passed through to Cashfree verbatim — see plan's Global Constraints
  pan                               String?
  gst                               String?
  cin                               String?
  uidai                             String? // Aadhar, stored as String (not a number) to avoid precision/leading-zero loss
  contactName                       String?
  contactEmail                      String?
  contactPhone                      String?
  cashfreeVendorStatus              String? // Cashfree's own async verification status (IN_BENE_CREATION/ACTIVE/ACTION_REQUIRED/...), distinct from our own `status` field
  status                            PaymentConnectionStatus @default(NOT_CONNECTED)
  settlementAccountName             String?
  settlementAccountNumberEncrypted  String? // encrypted via credential-encryption.util
  settlementIfsc                    String?
  settlementUpiVpa                  String?
  verifiedAt                        DateTime?
  lastWebhookAt                     DateTime?
  lastPaymentAt                     DateTime?
  createdAt                         DateTime                @default(now())
  updatedAt                         DateTime                @updatedAt
}

// Schema only in Phase 1 — no refund endpoint yet, so a later phase doesn't
// need its own migration.
model Refund {
  id               String        @id @default(uuid())
  paymentId        String
  payment          PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  restaurantId     String
  restaurant       Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  providerRefundId String?
  amount           Int // paise
  reason           String?
  status           RefundStatus  @default(PENDING)
  requestedBy      String?
  processedAt      DateTime?
  createdAt        DateTime      @default(now())

  @@index([restaurantId])
  @@index([paymentId])
}

// Every inbound webhook is stored raw before any processing, for idempotency
// and audit. restaurantId is nullable — unknown until the payload is parsed
// and matched to a PaymentTransaction — and backfilled once resolved.
model WebhookEvent {
  id               String                  @id @default(uuid())
  restaurantId     String?
  restaurant       Restaurant?             @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  provider         PaymentProvider         @default(CASHFREE)
  providerEventKey String // derived dedup key, e.g. `${type}:${cf_payment_id}` — Cashfree's payload carries no separate event id
  eventType        String
  rawPayload       Json
  signatureValid   Boolean
  processingStatus WebhookProcessingStatus @default(RECEIVED)
  processedAt      DateTime?
  retryCount       Int                     @default(0)
  errorMessage     String?
  createdAt        DateTime                @default(now())

  @@unique([provider, providerEventKey])
  @@index([restaurantId])
}


