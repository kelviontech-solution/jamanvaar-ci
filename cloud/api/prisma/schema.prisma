// JAMANVAAR Cloud — Phase 1a schema.
//
// Row-Level Security note: Prisma cannot express RLS policies declaratively.
// The initial migration is generated with `prisma migrate dev --create-only`
// and then hand-edited (see prisma/migrations/*_init/migration.sql) to add
// `ENABLE ROW LEVEL SECURITY` + `FORCE ROW LEVEL SECURITY` + policies on every
// tenant-owned table. FORCE is required — Postgres exempts table owners from
// RLS by default, and the app's DB role owns these tables, so without FORCE
// the policies below would be silently decorative.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Platform (Super Admin) identity — structurally separate from tenant User.
// No code path maps one to the other; a restaurant owner row can never
// satisfy a platform login query because it isn't in this table at all.
// ---------------------------------------------------------------------------

enum PlatformUserStatus {
  ACTIVE
  DISABLED
  PENDING_ACTIVATION
}

// Team/RBAC roles for platform staff — previously the API hardcoded every
// user's role to 'SUPER_ADMIN' in its responses regardless of this table,
// so hasPermission() on the frontend had nothing real to check.
enum PlatformRole {
  PLATFORM_OWNER
  SUPER_ADMIN
  PLATFORM_OPS
  SUPPORT_ADMIN
  FINANCE_ADMIN
  READ_ONLY
}

model PlatformUser {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String?            // null until a PENDING_ACTIVATION teammate sets their own password
  fullName     String
  role         PlatformRole       @default(SUPER_ADMIN)
  status       PlatformUserStatus @default(ACTIVE)
  invitedAt    DateTime?
  activatedAt  DateTime?
  // One-time invitation credential for activate() — same shape as
  // User.activationTokenHash (SEC-001): only the sha256 hash is stored, the
  // plaintext token is returned once, at invite time.
  activationTokenHash      String?
  activationTokenExpiresAt DateTime?
  lastLoginAt  DateTime?
  // B2-030: per-account login lockout, independent of the shared per-IP throttle.
  failedLoginAttempts      Int                @default(0)
  lockedUntil              DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // Login OTP (second factor, required on every sign-in): only the HMAC-keyed hash of the
  // 6-digit code is ever stored, matching User.passwordResetHash's pattern.
  loginOtpHash       String?
  loginOtpExpiresAt  DateTime?
  loginOtpSentAt     DateTime?
  loginOtpAttempts   Int                @default(0)

  refreshTokens    PlatformRefreshToken[]
  assignedTickets  SupportTicket[]
  createdTickets   SupportTicket[] @relation("SupportTicketCreatedBy")
  ticketComments   TicketComment[]
}

model PlatformRefreshToken {
  id             String    @id @default(uuid())
  platformUserId String
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  expiresAt      DateTime
  /// Set when this token is rotated (every login renewal) - not the same as the session ending.
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  /// One id per login. Refresh-token rotation keeps it, so the session list shows one row per login.
  sessionId      String    @default(uuid())
  sessionStartedAt DateTime @default(now())
  lastUsedAt     DateTime  @default(now())
  /// Set on every row of a session when the session is ended on purpose (revoke, logout, password change).
  /// The request guard rejects access tokens whose session has this set, so it takes effect at once.
  terminatedAt   DateTime?
  userAgent      String?
  ip             String?
  /// Approximate place of the sign-in (see common/security/geo.ts).
  location       String?

  @@index([platformUserId])
  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// Tenant hierarchy: Restaurant -> Branch -> User / Device.
// These four plus Subscription and ActivationKey are RLS-protected.
// ---------------------------------------------------------------------------

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Restaurant {
  /// Default display size (percent) for this restaurant's terminals; each terminal can override it (BUG-008).
  displayScalePercent Int @default(100)
  id              String           @id @default(uuid())
  name            String
  legalName       String?
  gstin           String?
  fssaiNumber     String?
  address         String?
  city            String?
  state           String?
  country         String           @default("India")
  timezone        String           @default("Asia/Kolkata")
  currency        String           @default("INR")
  defaultLanguage String           @default("en")
  /// Registered/verified mobile number this restaurant's customer-facing Restaurant ID is
  /// derived from. Editable (a restaurant's phone can change) — restaurantCode is NOT
  /// recomputed when this changes; it stays immutable once generated (spec section 3).
  mobile          String?
  /// Customer-facing Restaurant ID ("JM" + 10-digit mobile, e.g. JM9876543210). Immutable
  /// after creation. Null only for legacy rows not yet backfilled (see the Phase 1 backfill
  /// script) — every restaurant created after this migration always has one.
  restaurantCode  String?          @unique
  /// True when this code came from the migration-safe fallback path (no valid mobile found
  /// during backfill) rather than a real registered number — Super Admin should review and
  /// correct these (spec section 44).
  restaurantCodeIsFallback Boolean @default(false)
  status          RestaurantStatus @default(ACTIVE)
  /// BUG-015: whether the Restaurant Admin may upload their own menu CSV. Super Admin can
  /// always upload for the restaurant regardless of this flag.
  selfMenuUploadEnabled Boolean    @default(true)
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  branches      Branch[]
  users         User[]
  devices       Device[]
  subscriptions Subscription[]
  activationKeys ActivationKey[]
  invoices      Invoice[]
  payments      Payment[]
  backups       Backup[]
  supportTickets SupportTicket[]
  deviceCommands      DeviceCommand[]
  menuSyndications    RestaurantMenuSyndication[]
  syncEventLogs       SyncEventLog[]
  syncConflicts       SyncConflict[]
  offlineExtensions   OfflineExtension[]
  qrCodes             QrCode[]
  qrSettings          QrSettings[]
  qrEvents            QrEvent[]
  sandboxes           RestaurantSandbox[]
  restoreJobs         BackupRestoreJob[]
  applicationEntitlements ApplicationEntitlement[]
  orders                  Order[]
  paymentTransactions     PaymentTransaction[]
  paymentConnection       RestaurantPaymentConnection?
  refunds                 Refund[]
  webhookEvents           WebhookEvent[]
  menuSnapshotItems       MenuSnapshotItem[]
  syncedOrders            SyncedOrder[]
  processedSyncEvents     ProcessedSyncEvent[]
  syncSequences           SyncSequence[]
  numberSequences         NumberSequence[]
  inventoryMovements      InventoryMovement[]
  menuPublications        MenuPublication[]
  menuSnapshots           MenuSnapshot[]
  menuImages              MenuImage[]
  syncedEntities          SyncedEntity[]
  aiAccess                RestaurantAiAccess?
  aiUsage                 AiUsageDaily[]
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

model Branch {
  id           String       @id @default(uuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  code         String
  address      String?
  timezone     String       @default("Asia/Kolkata")
  status       BranchStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users   User[]
  devices Device[]
  activationKeys ActivationKey[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
}

enum TenantUserRole {
  OWNER
  MANAGER
  STAFF
}

enum TenantUserStatus {
  PENDING_ACTIVATION
  ACTIVE
  DISABLED
}

model User {
  id           String            @id @default(uuid())
  restaurantId String
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  email        String
  phone        String?
  passwordHash String?           // null until a PENDING_ACTIVATION owner sets their own password
  fullName     String
  role         TenantUserRole    @default(STAFF)
  status       TenantUserStatus  @default(PENDING_ACTIVATION)
  invitedAt    DateTime?
  activatedAt  DateTime?
  // One-time invitation credential for setInitialPassword (SEC-001). Only the
  // sha256 hash is stored — the plaintext token is returned once, at creation
  // time, the same way ActivationKey.code is. Both must be cleared/consumed
  // once a password is successfully set.
  activationTokenHash      String?
  activationTokenExpiresAt DateTime?
  // "Forgot password" (BUG-142): a one-time code emailed to the user. Only its hash is stored; it expires
  // quickly, is single-use, and is dropped after too many wrong guesses. `passwordResetSentAt` limits how
  // often a new one can be requested.
  passwordResetHash        String?
  passwordResetExpiresAt   DateTime?
  passwordResetSentAt      DateTime?
  passwordResetAttempts    Int               @default(0)
  // B2-030: per-account login lockout, independent of the shared per-IP throttle.
  failedLoginAttempts      Int               @default(0)
  lockedUntil              DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  refreshTokens TenantRefreshToken[]

  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@index([branchId])
}

// Tenant-user session tokens. Kept separate from PlatformRefreshToken (which is
// FK'd only to PlatformUser) since tenant and platform identities are structurally
// distinct. restaurantId is denormalized onto this row (not just reachable via
// userId) so the same tenant_isolation RLS policy shape used elsewhere applies here.
model TenantRefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  tokenHash    String    @unique
  /// The terminal this session was created on; revoking the device ends the session.
  deviceId     String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([restaurantId])
}

// ---------------------------------------------------------------------------
// Plans are platform-global (no restaurantId, no RLS).
// ---------------------------------------------------------------------------

enum PlanTier {
  CORE
  PRO
  QR
  ENTERPRISE
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum ProductFamily {
  RESTAURANT
  KIOSK
}

model FeatureCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  features Feature[]
}

model Feature {
  id                   String          @id @default(uuid())
  code                 String          @unique
  name                 String
  description          String
  categoryId           String
  category             FeatureCategory @relation(fields: [categoryId], references: [id])
  // Links to the real per-app enforcement mechanism for the 7 app-level features (null for the
  // 15 finer-grained legacy features that aren't a separate app).
  appCode              AppCode?
  // Bridges to the pre-existing Plan.entitlements JSON key this feature corresponds to, for the
  // 21 features that existed before this table did. Never set through the CRUD API — only the
  // seed sets it, since it documents a fact about already-existing data, not something to invent
  // going forward.
  legacyEntitlementKey String?         @unique
  // Per-app default device cap when the entitlement row has no override; null = Plan.maxDevices.
  defaultDeviceQuota   Int?
  // Plain string list of other Feature.id values, not an enforced FK — the API layer (not the
  // database) proves referential integrity here (see FeaturesService).
  dependsOnFeatureIds  String[]        @default([])
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([categoryId])
}

model Plan {
  id           String     @id @default(uuid())
  tier         PlanTier
  /// Which commercial product line this plan belongs to. A restaurant may hold one active
  /// subscription per family at once (see SubscriptionsService.assign) — e.g. a RESTAURANT
  /// Core/Pro/QR plan plus a separate KIOSK Standard/Pro add-on, concurrently.
  productFamily ProductFamily @default(RESTAURANT)
  name         String
  description  String?
  priceMonthly Int // paise, avoids float rounding
  priceYearly  Int?
  maxBranches  Int
  maxDevices   Int
  maxUsers     Int
  entitlements Json
  status       PlanStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  EXPIRED
}

model Subscription {
  id           String             @id @default(uuid())
  restaurantId String
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan               @relation(fields: [planId], references: [id])
  status       SubscriptionStatus @default(TRIAL)
  startDate    DateTime           @default(now())
  expiresAt    DateTime
  trialEndsAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  activationKeys ActivationKey[]
  invoices       Invoice[]
  applicationEntitlements ApplicationEntitlement[]

  @@index([restaurantId])
}

// ---------------------------------------------------------------------------
// Per-application provisioning. This is the reusable entitlement layer every
// client app (POS, POS Admin, Captain, KDS, Kiosk, Kiosk Admin) is gated
// against — one row per (subscription, appCode), rather than duplicating
// "is this app enabled" logic per application the way Plan.entitlements'
// flat boolean bag used to (and still does, for legacy/display purposes;
// this table is the actual source of truth going forward). restaurantId is
// denormalized here the same way ActivationKey does it, so the standard
// tenant_isolation RLS policy shape (restaurantId-keyed) applies unchanged.
// ---------------------------------------------------------------------------
enum AppCode {
  POS
  POS_ADMIN
  CAPTAIN
  KDS
  KIOSK
  KIOSK_ADMIN
  QR_ORDERING
}

model ApplicationEntitlement {
  id             String       @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  appCode        AppCode
  enabled        Boolean      @default(true)
  // Null means "inherit the plan's overall maxDevices" rather than a
  // per-app cap — most restaurants never need to override this.
  deviceQuota    Int?
  // Per-app configuration that doesn't belong on Restaurant/Branch: e.g.
  // { "menuSource": "MAIN_MENU", "paymentMode": "COUNTER_ONLY" } for Kiosk.
  // Optional and schemaless on purpose — each app defines its own shape.
  config         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([subscriptionId, appCode])
  @@index([restaurantId])
}

enum ActivationKeyDeviceType {
  POS
  POS_ADMIN
  CAPTAIN
  KDS
  KIOSK
  KIOSK_ADMIN
  ANY
}

enum ActivationKeyStatus {
  ACTIVE
  REDEEMED
  REVOKED
  EXPIRED
}

model ActivationKey {
  id                 String                  @id @default(uuid())
  code               String                  @unique // opaque public identifier, not a password
  restaurantId       String
  restaurant         Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  subscriptionId     String?
  subscription       Subscription?           @relation(fields: [subscriptionId], references: [id])
  allowedDeviceType  ActivationKeyDeviceType  @default(ANY)
  status             ActivationKeyStatus     @default(ACTIVE)
  expiresAt          DateTime
  redeemedAt         DateTime?
  redeemedByDeviceId String?
  /// BUG-048: the branch the terminal that redeems this key is bound to.
  branchId           String?
  branch             Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// Free-text name for the terminal this key is for ("Counter 1", "Kitchen wall"); becomes the device name.
  label              String?
  /// Keys generated together (a welcome kit) share a batch id.
  batchId            String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([restaurantId])
  @@index([branchId])
  @@index([batchId])
}

enum DeviceType {
  POS
  CAPTAIN
  KDS
  KIOSK
  POS_ADMIN
  KIOSK_ADMIN
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

model Device {
  id           String       @id @default(uuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  type         DeviceType
  publicKey    String?      // populated once the keypair activation flow (later phase) ships
  appVersion   String?
  status       DeviceStatus @default(PENDING)
  lastSeenAt   DateTime?
  lastSyncAt   DateTime?    // last time this device's local runtime successfully synced
  lastBackupAt DateTime?    // last time this device reported a completed local backup
  syncStatus   String?      // free-form status string reported by the device (e.g. "ok", "stale", "error: <reason>")
  // sha256 hash of the opaque bearer credential issued once at activation-redeem
  // time (DeviceAuthGuard). Never store the plaintext — same pattern as
  // TenantRefreshToken.tokenHash and User.activationTokenHash.
  deviceTokenHash String?  @unique
  activatedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  name             String?
  ipAddress        String?
  macAddress       String?
  osPlatform       String?
  isLocked         Boolean         @default(false)
  lockReason       String?
  lockedAt         DateTime?
  pendingSyncCount Int             @default(0)
  syncError        String?
  /// The menu version this device last reported as fully applied (see MenuPublication).
  menuVersion      Int?

  backups          Backup[]
  commands         DeviceCommand[]
  syncEventLogs    SyncEventLog[]
  syncConflicts    SyncConflict[]
  offlineExtensions OfflineExtension[]
  orders           Order[]
  syncedOrders     SyncedOrder[]
  syncedEntities   SyncedEntity[]

  @@index([restaurantId])
  @@index([branchId])
}

// ---------------------------------------------------------------------------
// Audit log — platform-readable, not RLS-scoped in this phase.
// ---------------------------------------------------------------------------

enum AuditActorType {
  PLATFORM
  TENANT
  SYSTEM
}

model AuditLog {
  id           String         @id @default(uuid())
  actorType    AuditActorType
  actorId      String?
  restaurantId String?
  action       String
  category     String
  details      Json?
  createdAt    DateTime       @default(now())

  @@index([restaurantId])
  @@index([actorType, actorId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Support Tickets — evolves the Support page from search+diagnostics into a
// real lightweight ticketing view (status, assignee, SLA), instead of every
// support interaction being a one-off audited action with no persistent
// record of the underlying issue.
// ---------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id           String         @id @default(uuid())
  /// Human-quotable number (shown as TKT-000123). Auto-incrementing, never reused.
  number       Int            @unique @default(autoincrement())
  restaurantId String? // null = platform-wide issue, not tied to one tenant
  restaurant   Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  subject      String
  description  String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  assignedToId String?
  assignedTo   PlatformUser?  @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  /// Set when platform staff raised it; null when the restaurant did (see source / raisedBy*).
  createdById  String?
  createdBy    PlatformUser?  @relation("SupportTicketCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  /// PLATFORM (staff raised it) or RESTAURANT (raised from Restaurant Admin).
  source       String         @default("PLATFORM")
  /// BILLING, SYNC, HARDWARE, ONBOARDING, FEATURE_REQUEST, OTHER
  category     String         @default("OTHER")
  raisedByUserId String?
  raisedByName   String?
  raisedByEmail  String?
  branchId     String?
  deviceId     String?
  slaDueAt     DateTime
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  comments    TicketComment[]
  events      TicketEvent[]
  attachments TicketAttachment[]

  @@index([restaurantId])
  @@index([status])
  @@index([assignedToId])
  @@index([source])
}

model TicketComment {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    PlatformUser? @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// PLATFORM or RESTAURANT; for a restaurant reply authorId is null and authorName says who.
  authorType String       @default("PLATFORM")
  authorName String?
  /// Internal notes are for the platform team only and never shown to the restaurant.
  internal  Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

/// The ticket's history: who changed what and when.
model TicketEvent {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// CREATED, STATUS, PRIORITY, ASSIGNEE, ATTACHMENT
  type      String
  actorType String        @default("PLATFORM")
  actorName String?
  fromValue String?
  toValue   String?
  /// Restaurant-visible? Assignee changes are internal.
  visibleToRestaurant Boolean @default(true)
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

/// Small screenshots / documents, stored in the database (limited to a few per ticket and a couple of MB each).
model TicketAttachment {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  sizeBytes  Int
  data       Bytes
  uploadedByType String    @default("PLATFORM")
  uploadedByName String?
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Billing & Invoices
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PAST_DUE
  VOID
  REFUNDED
}

enum PaymentMethod {
  MANUAL
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  GATEWAY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique
  restaurantId       String
  restaurant         Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  subscriptionId     String?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])
  planId             String?
  plan               Plan?         @relation(fields: [planId], references: [id])
  amount             Int           // in paise
  taxAmount          Int           // in paise (GST 18%)
  totalAmount        Int           // in paise
  currency           String        @default("INR")
  status             InvoiceStatus @default(ISSUED)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  dueDate            DateTime
  paidAt             DateTime?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payments Payment[]

  @@index([restaurantId])
  @@index([status])
}

// Atomic gapless-per-year counters for statutory document numbers (invoices and
// receipts). One row per "<PREFIX>-<financial year>". Never derived from a row
// count: counts repeat after deletes and collide under concurrency.
model InvoiceCounter {
  key   String @id
  value Int
}

model Payment {
  id              String        @id @default(uuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  restaurantId    String
  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  amount          Int           // in paise
  method          PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  receiptNumber   String?       @unique
  status          PaymentStatus @default(COMPLETED)
  notes           String?
  recordedBy      String?
  createdAt       DateTime      @default(now())

  @@index([invoiceId])
  @@index([restaurantId])
}

// ---------------------------------------------------------------------------
// Applications & Release Matrix
// ---------------------------------------------------------------------------

enum AppReleaseChannel {
  STABLE
  BETA
}

model AppRelease {
  id                  String             @id @default(uuid())
  appCode             String             // POS, RESTAURANT_ADMIN, CAPTAIN, KDS, KIOSK, KIOSK_ADMIN
  version             String             // e.g. "2.4.0"
  channel             AppReleaseChannel  @default(STABLE)
  minSupportedVersion String?
  supportedPlatforms  Json               // ["windows", "android", "web", "electron"]
  releaseNotes        String?
  downloadUrl         String?
  isMandatory         Boolean            @default(false)
  releasedAt          DateTime           @default(now())
  createdAt           DateTime           @default(now())

  @@unique([appCode, version])
  @@index([appCode])
}

// ---------------------------------------------------------------------------
// Platform Settings
// ---------------------------------------------------------------------------

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  category    String   @default("GENERAL")
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Real off-device backups. A row here means the payload was actually
// uploaded to object storage (see modules/backups/backup-storage.service.ts)
// — never created speculatively, never faked when storage isn't configured.
// ---------------------------------------------------------------------------

enum BackupMethod {
  MANUAL
  AUTOMATIC
}

enum BackupStatus {
  COMPLETED
  FAILED
}

model Backup {
  id                 String             @id @default(uuid())
  restaurantId       String
  restaurant         Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  deviceId           String?
  device             Device?            @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  method             BackupMethod       @default(MANUAL)
  status             BackupStatus       @default(COMPLETED)
  sizeBytes          Int
  storageKey         String             // object key within the configured bucket
  checksumSha256     String
  errorMessage       String?
  verificationStatus String?            @default("UNVERIFIED") // UNVERIFIED, VERIFIED, CORRUPT
  verifiedAt         DateTime?
  retentionDays      Int                @default(30)
  /// BUG-074: true when the stored object is AES-256-GCM encrypted (see BackupStorageService).
  encrypted          Boolean            @default(false)
  createdAt          DateTime           @default(now())

  restoreJobs        BackupRestoreJob[]

  @@index([restaurantId])
  @@index([deviceId])
}

// ---------------------------------------------------------------------------
// Device Remote Commands & MDM
// ---------------------------------------------------------------------------

enum DeviceCommandType {
  LOCK
  UNLOCK
  FORCE_LOGOUT
  REVOKE_SESSION
  REVOKE_AUTH
  REQUEST_SYNC
  REQUEST_HEALTH
  APP_UPDATE
  RESTART_APP
  CLEAR_CACHE
  REQUEST_DIAGNOSTICS
  DISABLE_DEVICE
  ENABLE_DEVICE
  WIPE_LOCAL_DATA
}

enum DeviceCommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  RUNNING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

model DeviceCommand {
  id             String              @id @default(uuid())
  deviceId       String
  device         Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  restaurantId   String
  restaurant     Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  commandType    DeviceCommandType
  status         DeviceCommandStatus @default(PENDING)
  payload        Json?
  result         Json?
  errorMessage   String?
  issuedById     String?
  /// Deliveries of this command beyond the first (no acknowledgement within the window).
  retryCount     Int                 @default(0)
  /// Lets a console retry a send without creating a second command.
  idempotencyKey String?
  issuedAt       DateTime            @default(now())
  acknowledgedAt DateTime?
  executedAt     DateTime?
  expiresAt      DateTime

  @@unique([deviceId, idempotencyKey])
  @@index([deviceId, status])
  @@index([restaurantId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Master Menu Catalog & Syndication
// ---------------------------------------------------------------------------

model MasterMenuCategory {
  id        String           @id @default(uuid())
  name      String           @unique
  slug      String           @unique
  icon      String?
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  items     MasterMenuItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model MasterMenuItem {
  id                     String                      @id @default(uuid())
  categoryId             String
  category               MasterMenuCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name                   String
  description            String?
  imageUrl               String?
  basePrice              Int                         // in paise
  preparationTimeMinutes Int                         @default(15)
  dietaryType            String                      @default("VEG") // VEG, NON_VEG, VEGAN, JAIN, SWAMINARAYAN
  isAvailable            Boolean                     @default(true)
  allergens              Json?                       // string[]
  tags                   Json?                       // string[]
  taxRate                Int                         @default(500) // 5.00% (500 paise basis points)
  hsnCode                String?                     @default("996331")
  recipe                 Json?
  syndications           RestaurantMenuSyndication[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([categoryId])
}

model RestaurantMenuSyndication {
  id           String         @id @default(uuid())
  restaurantId String
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  masterItemId String
  masterItem   MasterMenuItem @relation(fields: [masterItemId], references: [id], onDelete: Cascade)
  customPrice  Int?           // overridden restaurant price in paise
  customName   String?
  isCustomized Boolean        @default(false)
  autoSync     Boolean        @default(true)
  status       String         @default("ACTIVE")
  lastSyncedAt DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([restaurantId, masterItemId])
  @@index([restaurantId])
}

// ---------------------------------------------------------------------------
// Sync Observability & Conflicts
// ---------------------------------------------------------------------------

model SyncEventLog {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  deviceId     String?
  device       Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  entityType   String     // ORDER, MENU, INVENTORY, CUSTOMER
  entityId     String?
  /// Ties one journey (device -> server -> conflicts) together for support; defaults to the order id.
  traceId      String?
  eventId      String?
  action       String     // CREATE, UPDATE, DELETE
  status       String     // SUCCESS, FAILED, PENDING
  latencyMs    Int        @default(0)
  payloadSize  Int        @default(0)
  errorMessage String?
  timestamp    DateTime   @default(now())

  @@index([restaurantId, timestamp])
  @@index([status])
  @@index([traceId])
}

model SyncConflict {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  deviceId     String?
  device       Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  entityType   String
  entityId     String
  localVersion Json
  cloudVersion Json
  reason       String
  resolution   String     @default("PENDING") // PENDING, CLOUD_WINS, LOCAL_WINS, MANUAL_MERGE
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
  @@index([resolution])
}

// ---------------------------------------------------------------------------
// Emergency Offline Policy
// ---------------------------------------------------------------------------

model OfflineExtension {
  id                   String     @id @default(uuid())
  restaurantId         String
  restaurant           Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId             String?
  deviceId             String?
  device               Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  extensionDays        Int
  reason               String
  requestedBy          String
  ticketRef            String?
  approvedById         String
  status               String     @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED (EXPIRED is derived from validUntil when listing)
  certificatePayload   String
  certificateSignature String
  validFrom            DateTime   @default(now())
  validUntil           DateTime
  createdAt            DateTime   @default(now())

  @@index([restaurantId])
  @@index([deviceId])
}

// ---------------------------------------------------------------------------
// Staging Sandbox Clones
// ---------------------------------------------------------------------------

model RestaurantSandbox {
  id                 String     @id @default(uuid())
  sourceRestaurantId String
  sourceRestaurant   Restaurant @relation(fields: [sourceRestaurantId], references: [id], onDelete: Cascade)
  name               String
  environmentKey     String     @unique
  status             String     @default("ACTIVE") // CREATING, ACTIVE, EXPIRED, DELETED
  config             Json
  expiresAt          DateTime
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([sourceRestaurantId])
}

// ---------------------------------------------------------------------------
// Backup Restore Jobs
// ---------------------------------------------------------------------------

model BackupRestoreJob {
  id             String     @id @default(uuid())
  backupId       String
  backup         Backup     @relation(fields: [backupId], references: [id], onDelete: Cascade)
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  targetType     String     // STAGING_PREVIEW, PRODUCTION_RESTORE
  status         String     @default("PENDING") // PENDING, PREVIEW_READY, RESTORING, COMPLETED, FAILED
  previewSummary Json?
  errorMessage   String?
  initiatedById  String
  confirmedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())

  @@index([restaurantId])
  @@index([backupId])
}

// ---------------------------------------------------------------------------
// Cashfree Payment Gateway — Phase 1 (see docs/superpowers/specs/2026-09-09-
// cashfree-payment-phase1-design.md). Distinct model/enum names from the
// existing Payment/PaymentMethod/PaymentStatus above, which are platform
// subscription billing, not customer-order payments.
// ---------------------------------------------------------------------------

enum PaymentProvider {
  CASHFREE
}

// Only PLATFORM_POOLED (Cashfree Easy Split, one JAMANVAAR-owned account) is
// implemented in Phase 1. A true per-restaurant merchant-account mode would
// be added later via `ALTER TYPE ... ADD VALUE`, the same way AppCode and
// ActivationKeyDeviceType were extended in the application-entitlements
// migration — it requires Cashfree Partner/Platform approval JAMANVAAR does
// not have yet.
enum PaymentConnectionType {
  PLATFORM_POOLED
}

enum PaymentConnectionStatus {
  NOT_CONNECTED
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISCONNECTED
}

enum OrderPaymentStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  SENT_TO_POS
  PAYMENT_FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentTransactionStatus {
  CREATED
  PENDING
  AUTHORIZED
  SUCCESS
  FAILED
  USER_DROPPED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentTransactionMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
  OTHER
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WebhookProcessingStatus {
  RECEIVED
  VERIFIED
  PROCESSED
  FAILED
  IGNORED_DUPLICATE
}

// The trusted, backend-queryable copy of what a restaurant actually sells —
// pushed by Kiosk Admin (which already has a live device connection)
// whenever its local menu changes. Order totals are validated against this,
// never against prices the kiosk sends at checkout time.
model MenuSnapshotItem {
  id             String     @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  externalItemId String // the kiosk's own local item id
  name           String
  category       String?
  basePrice      Int // paise
  modifierGroups Json? // [{ id, name, isRequired, minSelections, maxSelections, options: [{ id, name, priceDelta }] }]
  taxRate        Int        @default(0) // basis points, e.g. 500 = 5.00%
  isAvailable    Boolean    @default(true)
  syncedAt       DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([restaurantId, externalItemId])
  @@index([restaurantId])
}

// Cloud order record — does not exist elsewhere; kiosks are offline-first
// and never had a cloud order model before this. items is an immutable
// snapshot captured at creation time from MenuSnapshotItem.
model Order {
  id              String             @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  kioskId         String?
  kiosk           Device?            @relation(fields: [kioskId], references: [id], onDelete: SetNull)
  externalOrderId String // correlates to the kiosk's local order id; doubles as the idempotency key
  items           Json // [{ externalItemId, name, quantity, unitPrice, modifiers, lineTotal }]
  subtotal        Int // paise
  taxAmount       Int // paise
  discountAmount  Int                @default(0) // paise
  totalAmount     Int // paise
  currency        String             @default("INR")
  status          OrderPaymentStatus @default(DRAFT)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  paymentTransactions PaymentTransaction[]

  @@unique([restaurantId, externalOrderId])
  @@index([restaurantId])
  @@index([kioskId])
}

model PaymentTransaction {
  id                String                    @id @default(uuid())
  orderId           String
  order             Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurantId      String
  restaurant        Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  provider          PaymentProvider           @default(CASHFREE)
  providerOrderId   String // the order_id we generate and send to Cashfree
  providerPaymentId String? // Cashfree's cf_payment_id, known once paid/failed
  amount            Int // paise
  currency          String                    @default("INR")
  status            PaymentTransactionStatus  @default(CREATED)
  method            PaymentTransactionMethod?
  paymentSessionId  String?
  providerResponse  Json? // sanitized webhook/API response, no secrets
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  refunds Refund[]

  @@unique([provider, providerOrderId])
  @@unique([provider, providerPaymentId])
  @@index([restaurantId])
  @@index([orderId])
  @@index([providerPaymentId])
}

// One per restaurant. Represents the Cashfree Easy Split vendor
// registration for Phase 1 (PLATFORM_POOLED) — settlement bank/UPI details,
// not independent API credentials.
enum CashfreeAccountType {
  BUSINESS
  INDIVIDUAL
}

model RestaurantPaymentConnection {
  id                                String                  @id @default(uuid())
  restaurantId                      String                  @unique
  restaurant                        Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  provider                          PaymentProvider         @default(CASHFREE)
  connectionType                    PaymentConnectionType   @default(PLATFORM_POOLED)
  cashfreeVendorId                  String?
  accountType                       CashfreeAccountType?
  businessType                      String? // free text, passed through to Cashfree verbatim — see plan's Global Constraints
  pan                               String?
  gst                               String?
  cin                               String?
  uidai                             String? // Aadhar, stored as String (not a number) to avoid precision/leading-zero loss
  contactName                       String?
  contactEmail                      String?
  contactPhone                      String?
  cashfreeVendorStatus              String? // Cashfree's own async verification status (IN_BENE_CREATION/ACTIVE/ACTION_REQUIRED/...), distinct from our own `status` field
  status                            PaymentConnectionStatus @default(NOT_CONNECTED)
  settlementAccountName             String?
  settlementAccountNumberEncrypted  String? // encrypted via credential-encryption.util
  settlementIfsc                    String?
  settlementUpiVpa                  String?
  verifiedAt                        DateTime?
  lastWebhookAt                     DateTime?
  lastPaymentAt                     DateTime?
  createdAt                         DateTime                @default(now())
  updatedAt                         DateTime                @updatedAt
}

// Schema only in Phase 1 — no refund endpoint yet, so a later phase doesn't
// need its own migration.
model Refund {
  id               String        @id @default(uuid())
  paymentId        String
  payment          PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  restaurantId     String
  restaurant       Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  providerRefundId String?
  amount           Int // paise
  reason           String?
  status           RefundStatus  @default(PENDING)
  requestedBy      String?
  processedAt      DateTime?
  createdAt        DateTime      @default(now())

  @@index([restaurantId])
  @@index([paymentId])
}

// Every inbound webhook is stored raw before any processing, for idempotency
// and audit. restaurantId is nullable — unknown until the payload is parsed
// and matched to a PaymentTransaction — and backfilled once resolved.
model WebhookEvent {
  id               String                  @id @default(uuid())
  restaurantId     String?
  restaurant       Restaurant?             @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  provider         PaymentProvider         @default(CASHFREE)
  providerEventKey String // derived dedup key, e.g. `${type}:${cf_payment_id}` — Cashfree's payload carries no separate event id
  eventType        String
  rawPayload       Json
  signatureValid   Boolean
  processingStatus WebhookProcessingStatus @default(RECEIVED)
  processedAt      DateTime?
  retryCount       Int                     @default(0)
  errorMessage     String?
  createdAt        DateTime                @default(now())

  @@unique([provider, providerEventKey])
  @@index([restaurantId])
}

// ---------------------------------------------------------------------------
// Order-sync bridge (POS/KDS/Captain). Distinct from `Order` above, which is
// the Kiosk/Cashfree checkout model — this is the general dine-in/takeaway
// order created at any terminal and pushed/pulled by any device on the same
// tenant so POS, KDS and Captain converge on one cloud copy instead of each
// only seeing what happened to reach it over LAN mesh or shared localStorage.
// `status` mirrors the local app's OrderStatus/KOT lifecycle as a plain
// string (NEW/PREPARING/READY/SERVED/BILLED/CANCELLED, etc.) rather than a
// Prisma enum, since the set of local statuses is owned by @jamanvaar/types
// and this bridge should not need a migration every time that list changes.
model SyncedOrder {
  id              String     @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  deviceId        String? // the device that created/last wrote this order
  device          Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /// BUG-048: the branch of the device that first pushed this order, for per-branch sales.
  branchId        String?
  externalOrderId String // the local app's own order id; doubles as the idempotency key
  orderType       String // DINE_IN / TAKEAWAY / DELIVERY / TOKEN_QR
  status          String
  tableId         String?
  tableLabel      String?
  items           Json // [{ externalItemId, name, quantity, unitPrice, modifiers, kitchenStatus, lineTotal }]
  subtotal        Int // paise
  taxAmount       Int // paise
  discountAmount  Int        @default(0) // paise
  totalAmount     Int // paise
  notes           String?
  paymentStatus   String? // PENDING / SUCCESS / ... as recorded by the device
  paymentMethod   String? // CASH / UPI / CARD / SPLIT / ...
  meta            Json? // order/token numbers, cashier, customer, tender lines, tax split, business day
  syncVersion     Int        @default(1) // bumped on every push; lets a puller detect it missed an update
  /// Monotonic per-branch change sequence (see SyncSequence): the pull cursor. Null only for rows written before it existed.
  seq             Int?
  /// POS | KIOSK | CAPTAIN | QR | ONLINE: the channel the order came from.
  source          String     @default("POS")
  /// Unguessable reference a guest tracks their order by; the internal id is never shown to customers.
  publicOrderId   String?    @unique
  qrCodeId        String?
  /// The published menu version this order was priced from (null for orders that were not priced from a snapshot).
  menuVersion     Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([restaurantId, externalOrderId])
  @@index([restaurantId, branchId, source, createdAt])
  @@index([restaurantId, updatedAt])
  @@index([restaurantId, branchId, seq])
  @@index([deviceId])
  @@index([branchId])
}

/// A QR code that customers scan (spec: QrCode). The token is minted by the server, unguessable, and tied to exactly
/// one restaurant + branch (+ table for TABLE_ORDER). A guest's phone knows only the token: it has no tenant context,
/// so this is the one lookup a request with no tenant identity may make, resolved in one indexed read.
/// Status: ACTIVE | DISABLED | REVOKED. Regenerating revokes the old code in the same transaction.
model QrCode {
  id            String     @id @default(uuid())
  publicToken   String     @unique
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId      String?
  /// The table's id in the synced DINING_TABLE entity; null for a MENU_ONLY code.
  tableId       String?
  tableNumber   String?
  status        String     @default("ACTIVE")
  /// TABLE_ORDER | MENU_ONLY
  mode          String     @default("TABLE_ORDER")
  version       Int        @default(1)
  revokedAt     DateTime?
  lastScannedAt DateTime?
  metadata      Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@index([restaurantId, tableId])
}

/// Per-restaurant (branchId null) or per-branch QR ordering switches. Database-backed, never hardcoded.
model QrSettings {
  id                   String     @id @default(uuid())
  restaurantId         String
  restaurant           Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId             String?
  orderingEnabled      Boolean    @default(true)
  tableOrderingEnabled Boolean    @default(true)
  menuOnlyEnabled      Boolean    @default(false)
  allowCustomerNotes   Boolean    @default(true)
  allowModifiers       Boolean    @default(true)
  allowCash            Boolean    @default(true)
  allowOnlinePayment   Boolean    @default(false)
  showOrderStatus      Boolean    @default(true)
  autoAccept           Boolean    @default(false)
  requireCustomerName  Boolean    @default(false)
  requireCustomerPhone Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

/// Facts about guest behaviour (scan, menu view, cart, order started/placed/failed). Analytics are computed from
/// these and from SyncedOrder.source = 'QR', never from numbers a client reports about itself.
model QrEvent {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  qrCodeId     String?
  sessionId    String?
  type         String
  metadata     Json?
  createdAt    DateTime   @default(now())

  @@index([restaurantId, type, createdAt])
  @@index([restaurantId, branchId, createdAt])
}

// A generic sync mirror for domains that don't (yet) need Order's dedicated
// columns — CRM/Customer, Inventory, POS-recorded payment transactions.
// Deliberately one flexible table instead of one bespoke model per domain:
// the shape that actually varies per domain (a customer's loyalty fields vs.
// an inventory item's stock levels) lives in `payload`, while the identity/
// versioning/RLS scaffolding — the part that's identical across every
// domain — is written once. `entityType` is an application-level enum
// (CUSTOMER / INVENTORY_ITEM / PAYMENT_TRANSACTION, validated in
// EntitySyncController), not a Prisma enum, for the same reason SyncedOrder's
// `status` isn't one: new domains shouldn't need a migration to add.
model SyncedEntity {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  deviceId     String?
  device       Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  entityType   String
  externalId   String // the local app's own key for this record (e.g. CustomerAccount.phone, InventoryItem.id)
  payload      Json
  syncVersion  Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, entityType, externalId])
  @@index([restaurantId, entityType, updatedAt])
  @@index([deviceId])
}



// ---------------------------------------------------------------------------
// JAMAN AI (BUG-055..058): the question catalogue, per-restaurant access and real usage live in the
// database, not in the API process's memory. The global thresholds are a PlatformSetting ("ai.settings").
// ---------------------------------------------------------------------------
model AiQuestion {
  id              String   @id
  category        String
  /// May contain {delayedKotMinutes} / {lowStockThreshold}, filled in from the settings when sent.
  label           String
  icon            String   @default("sparkles")
  intent          String
  minPlanTier     String   @default("PRO")
  priorityScore   Int      @default(50)
  isEnabled       Boolean  @default(true)
  isCustom        Boolean  @default(false)
  targetDomain    String?
  calculationType String?
  filterField     String?
  filterValue     String?
  displayUnit     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
}

/// A per-restaurant decision about JAMAN AI. `state` null means "follow the plan".
model RestaurantAiAccess {
  restaurantId       String     @id
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  state              String? // ON | LOCKED | OFF
  dailyQueryLimit    Int?
  thresholdOverrides Json?
  updatedAt          DateTime   @updatedAt
}

/// One row per restaurant, day and intent: real counts and measured latency.
model AiUsageDaily {
  id             String     @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  day            DateTime   @db.Date
  intent         String
  queries        Int        @default(0)
  totalLatencyMs Int        @default(0)

  @@unique([restaurantId, day, intent])
  @@index([day])
}

// ---------------------------------------------------------------------------
// Platform notification centre (BUG-064): a real store with severity, the exact record to open, and
// per-person read state, instead of two counters computed in the browser.
// ---------------------------------------------------------------------------
model PlatformNotification {
  id           String   @id @default(uuid())
  type         String // SUBSCRIPTION_EXPIRING, BACKUP_FAILED, INVOICE_OVERDUE, DEVICES_OFFLINE, KEYS_EXPIRING, SYNC_FAILING, RESTAURANT_SUSPENDED, TICKET_*
  severity     String   @default("INFO") // INFO | WARNING | CRITICAL
  title        String
  body         String?
  restaurantId String?
  targetType   String?
  targetId     String?
  /// The in-app path that opens the exact record.
  link         String
  /// The same underlying event never creates two notifications.
  dedupeKey    String   @unique
  /// When set, only this platform user sees it (an assignment, say); otherwise the whole team does.
  userId       String?
  createdAt    DateTime @default(now())

  reads PlatformNotificationRead[]

  @@index([createdAt])
  @@index([type])
  @@index([restaurantId])
  @@index([userId])
}

model PlatformNotificationRead {
  notificationId String
  notification   PlatformNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime             @default(now())

  @@id([notificationId, userId])
  @@index([userId])
}


// ---------------------------------------------------------------------------
// Sync redesign: exactly-once event application and a monotonic pull cursor.
// ---------------------------------------------------------------------------

/// One row per event the server has applied. (restaurantId, eventId) is unique, so a retried or
/// replayed push is recognised and answered from `result` instead of being applied again.
model ProcessedSyncEvent {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  eventId      String
  deviceId     String?
  entityType   String
  entityId     String
  result       Json
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, eventId])
  @@index([restaurantId, createdAt])
}

/// Change counter per (restaurant, branch). Bumped inside the same transaction as the write, so the
/// row lock makes sequence order equal commit order and a reader can never skip a lower number.
/// scope is the branchId, or "_" for a device with no branch.
model SyncSequence {
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  scope        String
  value        Int        @default(0)

  @@id([restaurantId, scope])
}

/// Human-readable order/KOT numbers are leased to devices in blocks, per branch and business day, so two
/// terminals numbering offline can never produce the same number. `next` is the first unleased number.
/// Shared request counters for rate limiting (PostgreSQL, no Redis). Not tenant data.
model RateCounter {
  key         String
  windowStart BigInt
  count       Int    @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

model NumberSequence {
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  scope        String // branchId, or "_" for a device with no branch
  kind         String // ORDER | KOT
  businessDate String // YYYYMMDD in the branch's timezone
  next         Int        @default(1)

  @@id([restaurantId, scope, kind, businessDate])
}

/// Stock is a ledger of signed movements per branch, never an overwritten quantity: two terminals that
/// each sell offline add up. (restaurantId, movementId) is unique, so a retried movement counts once.
model InventoryMovement {
  id            String     @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId      String?
  movementId    String // the device's own id for this movement; the idempotency key
  deviceId      String?
  itemId        String
  itemName      String
  type          String // PURCHASE | RESTOCK | SALE | SALE_REVERSAL | WASTE | SPOILAGE | ADJUSTMENT
  quantityDelta Float
  unit          String
  orderId       String?
  reason        String
  occurredAt    DateTime
  seq           Int // shared restaurant change sequence (see SyncSequence): the pull cursor
  createdAt     DateTime   @default(now())

  @@unique([restaurantId, movementId])
  @@index([restaurantId, branchId, seq])
  @@index([restaurantId, branchId, itemId])
}

/// A published menu version. Devices report the version they have applied, so support can see which one
/// is behind. `watermark` is the server time of the publish: a device that has pulled menu changes made
/// up to that moment has this version.
model MenuPublication {
  id                  String     @id @default(uuid())
  restaurantId        String
  restaurant          Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  version             Int
  watermark           DateTime
  note                String?
  publishedByDeviceId String?
  createdAt           DateTime   @default(now())

  @@unique([restaurantId, version])
}

/// A picture used by the published menu, addressed by the SHA-256 of its bytes.
model MenuImage {
  hash         String
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  contentType  String
  size         Int
  data         Bytes
  createdAt    DateTime   @default(now())

  @@id([restaurantId, hash])
  @@index([hash])
}

/// The menu as it was when the restaurant published it. Customers read this, never the live draft entities.
model MenuSnapshot {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  version      Int
  checksum     String
  content      Json
  note         String?
  publishedBy  String?
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, version])
}
