# Keeps the Docker build context small and the image free of anything that
# shouldn't ship or that gets rebuilt fresh inside the image anyway.

# Rebuilt fresh inside the image -- never copy the host's own
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/

# Rust/Tauri build artifacts -- huge, irrelevant to cloud/api and super-admin-web,
# and not something `npm ci` ever touches
**/src-tauri/target/
**/target/

# VCS and editor noise
.git/
.vscode/
.idea/

# Local-only env files -- real secrets must never enter a Docker build context
.env
.env.*
!.env.example

# Test artifacts and local databases
logs/
**/*.log
**/*.db
**/*.sqlite3
coverage/
**/coverage/

# This project's own working notes -- not needed inside any image
docs/
BUG_LIST*.md
*.md
!README.md
