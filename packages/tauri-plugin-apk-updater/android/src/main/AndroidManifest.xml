<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required since Android 8.0 (API 26) for any app that wants to start a package install
         intent at all. The device-side "Install unknown apps" toggle (per-app, user-controlled)
         is still required on top of this; this permission alone does not bypass that. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- ${applicationId} is resolved against whichever app (Kiosk, POS, ...) actually embeds
             this plugin, so each app gets its own non-colliding authority automatically. -->
        <provider
            android:name="com.jamanvaar.apkupdater.JamanvaarApkFileProvider"
            android:authorities="${applicationId}.jamanvaar.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/jamanvaar_apk_updater_paths" />
        </provider>
    </application>
</manifest>
